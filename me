function onStep()
	UpdatePlayerData(Player)

	local CurrentCFrame = Data.CurrentCFrame
	local PreviousCFrame = Data.PreviousCFrame
	if CurrentCFrame and PreviousCFrame then
		local CurrentPosition = Data.CurrentCFrame.p
		local PreviousPosition = Data.PreviousCFrame.p
		local Distance = (CurrentPosition-PreviousPosition).magnitude

		local ray = Ray.new(
			PreviousPosition,
			(CurrentPosition-PreviousPosition).unit*Distance
		)

		local PartHit, WorldHit, NormalHit, MaterialHit = workspace:FindPartOnRayWithIgnoreList(
			ray,
			GlobalIgnoreList,
			false,
			true
		)

		if PartHit then
			if PartHit:GetAttribute("VISUAL") then
				PartHit = nil
			end
		end

		--visualize(PreviousPosition, PreviousPosition+(CurrentPosition-PreviousPosition).unit*Distance, not PartHit)

		LastHack = PartHit and os.clock() or LastHack
	end
end

function getPlayerTorso(Player)
	if not Character then
		return nil
	end

	local Humanoid = Character:FindFirstChild("Humanoid")
	if not Humanoid or Humanoid.Health == 0 then
		return nil
	end

	local torso = Character:FindFirstChild("HumanoidRootPart")

	if not torso then
		return nil
	end

	return torso
end

function UpdatePlayerData(Player)
	local torso = getPlayerTorso(Player)
	if not torso then
		ClearPlayerData(Player)
		return
	end

	if not(Data.PreviousCFrame or Data.CurrentCFrame) then
		Data.PreviousCFrame = torso.CFrame
	else
		Data.PreviousCFrame = Data.CurrentCFrame
	end

	Data.CurrentCFrame = torso.CFrame
end

function ClearPlayerData(Player)
	Data = {
		PreviousCFrame = nil,
		CurrentCFrame = nil
	}
end

Connections.RegisteredConnections = {}

function ignoreListAction(part, ignore)
	if part:IsA("BasePart") then
		local found = table.find(GlobalIgnoreList, part)
		if ignore and not found then
			table.insert(GlobalIgnoreList, part)
		elseif not ignore and found then
			table.remove(GlobalIgnoreList, found)
		end
	end
end

function registerPart(part)
	if part:IsA("BasePart") then
		Connections.RegisteredConnections[part] = part:GetPropertyChangedSignal("CanCollide"):Connect(function()
			local char = LocalPlayer.Character or Character
			ignoreListAction(part, not part.CanCollide or (char and part:IsDescendantOf(char)))
		end)
	end
end

for _, part in workspace:GetDescendants() do
	registerPart(part)
end
