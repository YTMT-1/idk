function GetLocalFunction(fn, fs)
	local success, result = pcall(function()
		for _, v in getgc(true) do
			if typeof(v) == "function" then
				local name, src = debug.info(v,"n"), debug.info(v,"s")
				if name == fn and (not fs or fs == src) then
					return v
				end
			end
		end
	end)
	return success and result
end

